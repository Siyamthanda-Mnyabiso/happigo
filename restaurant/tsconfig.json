{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@core/*": [
        "../src/lib/*"
      ],
      "zod": [
        "./node_modules/zod"
      ],
      "@native/*": [
        "../native-shared/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}